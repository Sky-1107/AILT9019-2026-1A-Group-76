# Live provider configuration
# PROVIDER selects the API protocol:
#   completions -> OpenAICompletionsProvider (POST /chat/completions; OpenAI-compatible endpoints)
#   responses   -> OpenAIProvider (POST /responses; OpenAI Responses API)
PROVIDER=responses
API_KEY=
BASE_URL=https://api.hku.hk/openai/student/v1
MODEL=gpt-4.1-nano
TEMPERATURE=0.4
TIMEOUT_SECONDS=90
MAX_OUTPUT_TOKENS=2000

# Behavior
MOCK_MODE=1
MCP_ENABLED=1
MCP_REQUIRED=0
SESSION_RETENTION_HOURS=24

# Flask
FLASK_DEBUG=0
SECRET_KEY=change-me
